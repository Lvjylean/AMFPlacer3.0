# Read-only verification of one immutable, completely routed design.
source [lindex $argv 0]
source [file join [file dirname [info script]] dfx_joint_checks.tcl]
proc main {} {
 global dfx
 set_param general.maxThreads $dfx(vivado_threads)
 if {$dfx(vivado_threads)!=4 || $dfx(clock_period_ns)!=$dfx(experiment_clock_period_ns)} {error "Unexpected verification conditions"}
 if {$dfx(verification_mode) eq "static"} {
  amf_dfx::timed pr_verify {pr_verify -full_check $dfx(reference_checkpoint) $dfx(routed_checkpoint)}
  set f [open $dfx(output)/pr_verify_passed.txt w]; puts $f full_check_passed; close $f
 } elseif {$dfx(verification_mode) eq "qor"} {
  amf_dfx::timed open_routed {open_checkpoint $dfx(routed_checkpoint)}
  set requests {}; set boundaries {}
  foreach row $dfx(rps) {
   lassign $row id rp pb
   dict set requests $id [joint::requested $id $rp]
   dict set boundaries $id [amf_dfx::read_dict [file join $dfx(common_static_metadata) [set id]_common_static_boundary.tcldata]]
  }
  set footprints [amf_dfx::read_dict $dfx(imported_footprints)]
  amf_dfx::timed audit_joint {joint::audit joint $requests $boundaries $footprints}
  # Descriptive reports are generated by an independent post-completion job.
 } else {error "Unknown verification mode"}
 puts AMF_PARALLEL_VERIFICATION_COMPLETED
}
if {[catch {main} msg opts]} {puts stderr $msg; puts stderr [dict get $opts -errorinfo]; exit 2}
exit 0
